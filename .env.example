AEROTWIN_OPENAI_API_KEY=
AEROTWIN_OPENAI_MODEL=gpt-4o-mini
AEROTWIN_OPENAI_BASE_URL=
AEROTWIN_CORS_ORIGINS=["http://localhost:5173"]
