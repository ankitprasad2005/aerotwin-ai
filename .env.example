AEROTWIN_DATABASE_URL=postgresql+asyncpg://aerotwin:aerotwin@postgres:5432/aerotwin
AEROTWIN_OPENAI_API_KEY=
AEROTWIN_OPENAI_MODEL=gpt-4o-mini
AEROTWIN_OPENAI_BASE_URL=
AEROTWIN_CORS_ORIGINS=["http://localhost:5173"]
# Secret for the SearXNG container (docker-compose). Use any long random string.
SEARXNG_SECRET=change-me-to-a-long-random-string
# Blank disables web search; docker-compose sets it to the searxng service.
AEROTWIN_SEARXNG_URL=
# Optional OpenSky Network OAuth2 client (https://opensky-network.org, Account page). Blank = anonymous access:
# live aircraft counts work, previous-day airport arrivals/departures need credentials.
AEROTWIN_OPENSKY_CLIENT_ID=
AEROTWIN_OPENSKY_CLIENT_SECRET=
